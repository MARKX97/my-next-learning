{
  "name": "my-nest-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:style": "stylelint \"src/**/*.{css,scss,sass,less}\" --fix",
    "lint:all": "pnpm lint:fix && pnpm lint:style",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "preview": "bash tools/nginx-start.sh",
    "preview:stop": "bash tools/nginx-stop.sh",
    "preview:check": "bash -lc 'NGINX_BIN=$(command -v nginx || echo /opt/homebrew/bin/nginx) && \"$NGINX_BIN\" -t -c \"$(pwd)/tools/nginx-local-project.conf\" -p \"$(pwd)/tools/nginx-root/\"'",
    "preview:verify": "bash tools/preview-verify.sh"
  },
  "homepage": "https://MARKX97.github.io/my-next-learning/",
  "dependencies": {
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@semantic-release/changelog": "*",
    "@semantic-release/commit-analyzer": "*",
    "@semantic-release/git": "*",
    "@semantic-release/github": "*",
    "@semantic-release/release-notes-generator": "*",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "semantic-release": "*",
    "stylelint": "^16.25.0",
    "stylelint-config-css-modules": "^4.5.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "^5"
  }
}
